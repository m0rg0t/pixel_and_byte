---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";
import Footer from "../../components/footer.astro";

// Get all blog posts and sort by publication date in descending order
const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const description =
  "Блог команды Пиксель & Байт о веб-разработке, Astro, Node.js, VK Mini Apps и создании цифровых продуктов.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Блог Пиксель & Байт",
  description,
  url: "https://pixel-and-byte.ru/blog/",
  inLanguage: "ru-RU",
  isPartOf: { "@id": "https://pixel-and-byte.ru/#website" },
  about: ["Веб-разработка", "Astro", "Node.js", "VK Mini Apps"],
};
---

<Layout title="Блог" {description} {structuredData}>
  <Nav />
  <main class="max-w-5xl mx-auto pt-24 md:pt-28 pb-16">
    <p class="text-lg text-[var(--sec)] mb-2">Заметки команды</p>
    <h1 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-8">
      Блог
    </h1>

    <div class="grid gap-8 md:grid-cols-2">
      {
        sortedPosts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString(
            post.data.lang,
            {
              year: "numeric",
              month: "short",
              day: "numeric",
            },
          );

          return (
            <article class="bg-[#1414149c] border border-[var(--white-icon-tr)] p-5 md:p-6 rounded-2xl transition-transform hover:scale-[1.02]">
              <a
                href={`/blog/${post.id}`}
                class="block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
              >
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-48 object-cover mb-4 rounded-md"
                  />
                )}
                <h2 class="text-2xl font-semibold text-[var(--white)] mb-2">
                  {post.data.title}
                </h2>
                <p class="text-[var(--white-icon)] mb-4">
                  Опубликовано {formattedDate}
                </p>
                <p class="text-[var(--white)] mb-3">{post.data.description}</p>

                {post.data.tags && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {post.data.tags.map((tag) => (
                      <span class="px-2 py-1 bg-[var(--background)] text-[var(--white)] text-xs rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          );
        })
      }
    </div>
  </main>
  <Footer />
</Layout>
