---
import Layout from "./Layout.astro";
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  lang: string;
  image?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, lang, image, tags } =
  Astro.props;

const formattedPubDate = pubDate.toLocaleDateString(lang, {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString(lang, {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const siteOrigin = Astro.site ?? new URL("https://pixel-and-byte.ru");
const articleURL = new URL(Astro.url.pathname, siteOrigin).href;
const articleImageURL = image ? new URL(image, siteOrigin).href : undefined;
const publishedLabel = lang === "en-US" ? "Published" : "Опубликовано";
const updatedLabel = lang === "en-US" ? "Updated" : "Обновлено";
const authorLabel = lang === "en-US" ? "Author" : "Автор";
const teamLabel =
  lang === "en-US" ? "Pixel & Byte team" : "команда Пиксель & Байт";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url: articleURL,
    mainEntityOfPage: articleURL,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: lang,
    ...(articleImageURL ? { image: articleImageURL } : {}),
    author: {
      "@type": "Organization",
      name: "Пиксель & Байт",
      url: "https://pixel-and-byte.ru/",
    },
    publisher: { "@id": "https://pixel-and-byte.ru/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Главная",
        item: "https://pixel-and-byte.ru/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Блог",
        item: "https://pixel-and-byte.ru/blog/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: title,
        item: articleURL,
      },
    ],
  },
];
---

<Layout
  {title}
  {description}
  image={image}
  imageAlt={title}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  {lang}
  {structuredData}
>
  <Nav />
  <article class="mx-auto max-w-3xl pt-24 md:pt-28 pb-16">
    <div class="mb-8">
      {
        image && (
          <img
            src={image}
            alt={title}
            class="w-full h-64 object-cover rounded-lg mb-4"
          />
        )
      }
      <h1 class="text-3xl font-bold text-[var(--white)] mb-2">{title}</h1>
      <p class="text-[var(--white-icon)] mb-4">{description}</p>
      <div class="flex items-center text-sm text-[var(--white-icon)]">
        <span>{publishedLabel} {formattedPubDate}</span>
        {
          updatedDate && (
            <span class="ml-4">
              {updatedLabel} {formattedUpdatedDate}
            </span>
          )
        }
      </div>
      <p class="mt-3 text-sm text-[var(--white-icon)]">
        {authorLabel}: <a
          href="/team"
          class="text-[var(--white)] hover:text-[var(--sec)]">{teamLabel}</a
        >
      </p>
      {
        tags && tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-2 py-1 bg-[var(--white-icon-tr)] text-[var(--white)] text-xs rounded">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
    <div class="prose text-[var(--white)] max-w-none">
      <slot />
    </div>
  </article>
  <Footer />
</Layout>

<style>
  .prose {
    line-height: 1.6;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--white);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose p {
    margin-bottom: 1em;
  }

  .prose a {
    color: var(--sec);
    text-decoration: underline;
  }

  .prose ul,
  .prose ol {
    margin-left: 1.5em;
    margin-bottom: 1em;
  }

  .prose blockquote {
    border-left: 3px solid var(--sec);
    padding-left: 1em;
    margin-left: 0;
    color: var(--white-icon);
  }

  .prose code {
    background-color: var(--white-icon-tr);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  .prose pre {
    background-color: #1e1e1e;
    padding: 1em;
    border-radius: 5px;
    overflow-x: auto;
    margin: 1em 0;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
</style>
