---
import { Image } from "astro:assets";
import { featuredApps } from "../data/publishedApps";

interface Project {
  title: string;
  image: string; // updated to string for logo path
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = featuredApps.map((app) => ({
  title: app.name,
  image: app.logo!,
  link: app.detailsPath ?? app.url,
  preview: app.detailsPath ?? app.url,
  status: app.description,
}));
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Наши работы</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">VK Mini Apps</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => {
          const isExternal = project.preview.startsWith("http");

          return (
            <article class="group">
              <a
                href={project.preview}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                aria-label={`Открыть проект «${project.title}»`}
                class="block rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
              >
                <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                  <Image
                    inferSize={true}
                    width={576}
                    height={576}
                    src={project.image}
                    alt={project.title}
                    class="w-full h-48 md:aspect-square md:h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              </a>
              <div class="flex items-center gap-3 px-3">
                <a
                  href={project.preview}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="min-w-0 flex-grow rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
                >
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  <span class="block py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </a>
                <a
                  href={project.preview}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  aria-label={`Открыть проект «${project.title}»`}
                  class="size-14 shrink-0 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-7"
                  >
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
    <a
      href="/apps/"
      class="w-full flex items-center justify-center gap-2 mt-10 text-[var(--white)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] px-5 py-4 rounded-full bg-[#17171b] hover:bg-[var(--white-icon-tr)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
    >
      <span class="md:text-lg text-md">Все опубликованные приложения</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
